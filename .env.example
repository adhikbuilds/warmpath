# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon: use pooled for DATABASE_URL, direct for DIRECT_URL
# Get from: neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Intelligence Service (Python FastAPI on Azure Container Apps) ─────────────
# After backend deploys, get FQDN from: Azure Portal → Container Apps → warmpath-intelligence → Overview
INTELLIGENCE_SERVICE_URL=http://localhost:8001
INTELLIGENCE_SERVICE_SECRET=change-me-in-production

# ── Azure OpenAI (LLM for AI generation) ─────────────────────────────────────
# Azure Portal → Azure OpenAI resource → Keys and Endpoint
# Deploy model: gpt-4.1-nano in your resource
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano

# ── Google OAuth ──────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── LinkedIn OAuth ────────────────────────────────────────────────────────────
# linkedin.com/developers → Create app → Products: "Sign In with LinkedIn using OpenID Connect"
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Set to "true" once LINKEDIN_CLIENT_ID/SECRET are filled in — enables the LinkedIn login button
NEXT_PUBLIC_LINKEDIN_ENABLED=

# ── Stripe (optional — demo mode when absent) ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_GROWTH=price_growth_monthly
STRIPE_PRICE_SCALE=price_scale_monthly

# ── Resend (for daily briefing emails) ───────────────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=

# ── Optional integrations ─────────────────────────────────────────────────────
# Twenty CRM (self-hosted)
TWENTY_API_URL=http://localhost:3001/api
TWENTY_API_KEY=

# Happenstance relationship intelligence
HAPPENSTANCE_API_KEY=

# Slack (for team digest)
SLACK_WEBHOOK_URL=

# Calendly (for "Book a call" CTAs on landing page)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link
