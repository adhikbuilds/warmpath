# Postgres — same DB as frontend or a separate one
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Must match INTELLIGENCE_SERVICE_SECRET in the frontend env
SERVICE_SECRET=change-me-in-production

# AI provider switch: anthropic | azure_openai | mock  (any failure → mock)
AI_PROVIDER=anthropic

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Azure OpenAI (used when AI_PROVIDER=azure_openai) — e.g. the droid-llm resource.
# Deployment name is the model the customer wants; swapping it is config-only.
AZURE_OPENAI_ENDPOINT=https://droid-llm.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
AZURE_OPENAI_API_VERSION=2024-10-21
